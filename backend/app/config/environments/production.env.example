# PRODUCCIÓN (Render). NO llenes este archivo en el repositorio:
# copia cada variable en Render -> tu Web Service -> Environment.
# Las variables de Render siempre tienen prioridad sobre cualquier archivo .env.

NODE_ENV=production

# BASE DE DATOS (Aiven -> tu servicio MySQL -> Overview -> Connection information)
DB_HOST=mysql-libreria-xxxx.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=la-contraseña-de-aiven
DB_NAME=defaultdb
# Certificado "CA certificate" de Aiven: pega todo el texto, desde -----BEGIN CERTIFICATE----- hasta -----END CERTIFICATE-----
DB_SSL_CA=-----BEGIN CERTIFICATE-----...

# SEGURIDAD: frase larga y aleatoria (distinta a la de desarrollo)
JWT_SECRET=una-frase-larga-y-secreta

# CORREO (RF2, RF26, RF28) · Gmail con contraseña de aplicación
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=contraseña-de-aplicacion-de-16-letras
SMTP_FROM="Librería Andrés <tu-correo@gmail.com>"

# OPCIONALES
ALERTAS_CORREO=correo-del-encargado@gmail.com      # RF10: aviso de stock bajo
URL_TIENDA=https://libreria-andres.onrender.com    # enlace que va en los correos

# Copia este archivo como "developer.env" y llena tus valores.
# developer.env NO se sube a GitHub (está en .gitignore) porque tiene contraseñas.

PORT=3000

# BASE DE DATOS (XAMPP)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=proyecto
DB_PORT=3306

# SEGURIDAD: una frase larga y secreta para firmar los tokens de sesión
JWT_SECRET=cambia-esto-por-una-clave-larga

# CORREO (RF2) · Gmail con contraseña de aplicación
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=contraseña-de-aplicacion-de-16-letras
SMTP_FROM="Librería Andrés <tu-correo@gmail.com>"
